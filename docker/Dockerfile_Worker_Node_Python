FROM node:20-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV THESIS_NODE_SERVER_DIR=/dfl/node_server
ENV PYTHON_SERVICE_HOST=0.0.0.0
ENV PYTHON_SERVICE_PORT=8000

WORKDIR /dfl

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        bash \
        curl \
        python3 \
        python3-venv \
        python3-pip && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/python -m pip install --upgrade pip && \
    /opt/venv/bin/python -m pip install cryptography numpy pyzmq && \
    /opt/venv/bin/python -m pip install --index-url https://download.pytorch.org/whl/cpu torch

ENV PATH="/opt/venv/bin:${PATH}"

COPY cloud_setup/ansible/config ./config
COPY docker/keys ./keys

COPY node_server/package*.json ./node_server/
WORKDIR /dfl/node_server
RUN npm ci

WORKDIR /dfl
COPY node_server ./node_server
COPY python_worker ./python_worker
COPY docker/start_node_python_worker.sh ./start_node_python_worker.sh

COPY neural_network/data/train-images.idx3-ubyte ./node_server/data/train-images.idx3-ubyte
COPY neural_network/data/train-labels.idx1-ubyte ./node_server/data/train-labels.idx1-ubyte
COPY neural_network/data/t10k-images.idx3-ubyte ./node_server/data/t10k-images.idx3-ubyte
COPY neural_network/data/t10k-labels.idx1-ubyte ./node_server/data/t10k-labels.idx1-ubyte
COPY neural_network/data/random_start.bin ./node_server/data/random_start.bin

RUN chmod +x /dfl/start_node_python_worker.sh && \
    mkdir -p /dfl/node_server/data/results_iid /dfl/node_server/received_models

WORKDIR /dfl/node_server

EXPOSE 8000 5555

CMD ["node", "/dfl/node_server/dist/server.js"]
