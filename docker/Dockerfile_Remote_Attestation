FROM ghcr.io/foundry-rs/foundry

USER root
WORKDIR /dfl

COPY --chown=root:root smart_contract ./smart_contract
COPY --chown=root:root remote_attestation ./remote_attestation

RUN apt-get update && \
    apt-get install -y jq && \
    apt-get install -y curl


RUN mkdir -p /dfl/remote_attestation/out \
 && chmod -R a+rwX /dfl/remote_attestation \
 && if id -u foundry >/dev/null 2>&1; then chown -R foundry:foundry /dfl/remote_attestation; fi

WORKDIR /dfl/remote_attestation


