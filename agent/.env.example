# Local IPFS API, not the browser web UI URL.
IPFS_API_URL=http://127.0.0.1:5001

# On-chain source of truth for the current global model.
AGENT_SOURCE=contract
RPC_URL=http://127.0.0.1:8545
GM_STORAGE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# MFS path or immutable IPFS path to scan.
# Only used with AGENT_SOURCE=ipfs-scan.
# Use "/" for MFS root, or "/ipfs/<cid>" for an immutable DAG.
IPFS_ROOT=/

# Optional for the LangChain LLM mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Defaults used by the local ZK MCP tools.
AGENT_DOWNLOAD_DIR=agent/downloads
AGENT_PAIR_WINDOW_SECONDS=120
ZK_WORKDIR=zk_inference/out
ZK_QUERY_DIR=zk_inference/single_query
